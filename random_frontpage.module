<?php

/**
 * @file
 * Module file for random_frontpage module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\random_frontpage\Hook\RandomFrontpageHooks;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function random_frontpage_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(RandomFrontpageHooks::class)->help($route_name, $route_match);
}
